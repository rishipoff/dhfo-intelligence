# Price feed to use.
#   chain  (default) — yahoo -> nse -> manual, per ticker, with source tagging
#   yahoo           — Yahoo Finance (yfinance), live-delayed
#   nse             — NSE public quote (best-effort; often blocked by bot-wall)
#   manual          — data/prices.json hand snapshot only
#   breeze          — ICICI Breeze (stub, not implemented)
FEED=chain
